# =============================================================================
# EstateEase AI — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Gemini AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Property Data Source ---
# Supported values: excel, mongodb, mysql, postgresql, api
DATA_SOURCE=excel

# --- Excel (demo data source) ---
PROPERTY_EXCEL_FILE=real_estate_properties.xlsx

# --- MongoDB ---
MONGODB_URI=
MONGODB_DATABASE=
MONGODB_COLLECTION=properties

# --- MySQL ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_PROPERTIES_TABLE=properties

# --- PostgreSQL ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_PROPERTIES_TABLE=properties

# --- REST API ---
PROPERTY_API_URL=
PROPERTY_API_KEY=

# --- Google Sheets (customer data: leads, chat history, visit requests) ---
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=credentials.json

# --- App ---
PORT=5000
FLASK_DEBUG=true
